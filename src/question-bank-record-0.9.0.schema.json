{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://testparrot.com/formats/question-bank/0.9.0/schema.json",
  "title": "Test Parrot Question Bank Record 0.9.0",
  "description": "The authoritative machine-readable Question Bank Record a Test Parrot Package carries. Its Media Assets name picture files that travel beside the package in its zip.",
  "type": "object",
  "required": [
    "format",
    "formatVersion",
    "generator",
    "requiredFeatures",
    "bank",
    "media"
  ],
  "properties": {
    "format": {
      "const": "test-parrot/question-bank"
    },
    "formatVersion": {
      "const": "0.9.0"
    },
    "generator": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "requiredFeatures": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "bank": {
      "type": "object",
      "required": [
        "name",
        "questions"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "license": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          }
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/question"
          }
        }
      }
    },
    "media": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mediaAsset"
      }
    }
  },
  "$defs": {
    "document": {
      "type": "object",
      "required": [
        "type",
        "content"
      ],
      "properties": {
        "type": {
          "const": "document"
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "stemDocument": {
      "description": "A Question's or a Part's stem: a document whose top-level blocks may also be Side-by-Sides.",
      "type": "object",
      "required": [
        "type",
        "content"
      ],
      "properties": {
        "type": {
          "const": "document"
        },
        "content": {
          "type": "array",
          "items": {
            "type": "object",
            "if": {
              "properties": {
                "type": {
                  "const": "side-by-side"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "$ref": "#/$defs/sideBySide"
            },
            "else": {
              "$ref": "#/$defs/node"
            }
          }
        }
      }
    },
    "sideBySide": {
      "description": "Two or three Panels laid across one line, left to right. It is only ever a top-level block of a stem, and never holds another.",
      "type": "object",
      "required": [
        "type",
        "content"
      ],
      "properties": {
        "type": {
          "const": "side-by-side"
        },
        "content": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/panel"
          }
        }
      }
    },
    "panel": {
      "description": "One area of a Side-by-Side, holding at least one block a stem may hold other than a Side-by-Side.",
      "type": "object",
      "required": [
        "type",
        "content"
      ],
      "properties": {
        "type": {
          "const": "panel"
        },
        "content": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "mark": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "strong",
            "emphasis",
            "inline-code",
            "strike",
            "subscript",
            "superscript",
            "link"
          ]
        },
        "href": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "link"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "href": {
                "type": "string"
              }
            },
            "required": [
              "href"
            ]
          }
        }
      ]
    },
    "node": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "paragraph",
            "heading",
            "blockquote",
            "bullet-list",
            "ordered-list",
            "list-item",
            "code-block",
            "rule",
            "table",
            "table-row",
            "table-cell",
            "inline-math",
            "display-math",
            "hard-break",
            "text",
            "inline-image",
            "block-image"
          ]
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "text": {
          "type": "string"
        },
        "marks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mark"
          }
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "start": {
          "type": "integer",
          "minimum": 1
        },
        "language": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "header": {
          "type": "boolean"
        },
        "asset": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "alt": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        },
        "authoredSize": {
          "description": "Authored Image Size: the width of what the picture shows as a share of its container (the Question Content lane, a Panel or an answer cell), 0.05–1. Absent, the picture fits its container at its own width, or the container’s when that is narrower.",
          "type": "number",
          "minimum": 0.05,
          "maximum": 1
        },
        "crop": {
          "$ref": "#/$defs/crop"
        },
        "pending": {
          "$ref": "#/$defs/pending"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "text"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "text": {
                "type": "string"
              }
            },
            "required": [
              "text"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "inline-image",
                  "block-image"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "oneOf": [
              {
                "properties": {
                  "asset": true
                },
                "required": [
                  "asset"
                ]
              },
              {
                "properties": {
                  "pending": true
                },
                "required": [
                  "pending"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "inline-math",
                  "display-math"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "source": {
                "type": "string"
              }
            },
            "required": [
              "source"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "crop": true
            },
            "required": [
              "crop"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "block-image"
              },
              "asset": true
            },
            "required": [
              "type",
              "asset"
            ]
          }
        }
      ]
    },
    "mediaAsset": {
      "type": "object",
      "required": [
        "id",
        "mimeType",
        "width",
        "height",
        "file"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "mimeType": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "description": "Pixel width of the upright picture, after any EXIF orientation."
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "description": "Pixel height of the upright picture, after any EXIF orientation."
        },
        "file": {
          "description": "The path, inside the package’s zip, of the file holding this Media Asset’s original bytes: `media/` and the asset’s SHA-256 digest, with the extension its MIME type takes.",
          "type": "string",
          "pattern": "^media/sha256-[a-f0-9]{64}\\.(png|jpg|webp)$"
        }
      }
    },
    "choice": {
      "type": "object",
      "required": [
        "id",
        "content",
        "correct"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^q[1-9][0-9]*-c[1-9][0-9]*$"
        },
        "content": {
          "$ref": "#/$defs/document"
        },
        "correct": {
          "type": "boolean"
        },
        "locked": {
          "description": "Whether this answer is a Locked Answer, which keeps its authored position however answers are shuffled. `true` locks it; `false` records that its author unlocked it, so a consumer that locks answers by their wording must not; absent, the record makes no decision.",
          "type": "boolean"
        }
      }
    },
    "prompt": {
      "type": "object",
      "required": [
        "id",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^q[1-9][0-9]*-p[1-9][0-9]*$"
        },
        "content": {
          "$ref": "#/$defs/document"
        },
        "answer": {
          "type": "string",
          "pattern": "^q[1-9][0-9]*-a[1-9][0-9]*$"
        }
      }
    },
    "wordBankAnswer": {
      "type": "object",
      "required": [
        "id",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^q[1-9][0-9]*-a[1-9][0-9]*$"
        },
        "content": {
          "$ref": "#/$defs/document"
        }
      }
    },
    "partChoice": {
      "type": "object",
      "required": [
        "id",
        "content",
        "correct"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^q[1-9][0-9]*-s[1-9][0-9]*-c[1-9][0-9]*$"
        },
        "content": {
          "$ref": "#/$defs/document"
        },
        "correct": {
          "type": "boolean"
        },
        "locked": {
          "description": "Whether this answer is a Locked Answer, which keeps its authored position however answers are shuffled. `true` locks it; `false` records that its author unlocked it, so a consumer that locks answers by their wording must not; absent, the record makes no decision.",
          "type": "boolean"
        }
      }
    },
    "part": {
      "type": "object",
      "required": [
        "id",
        "stem"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^q[1-9][0-9]*-s[1-9][0-9]*$"
        },
        "type": {
          "enum": [
            "multiple-choice",
            "short-answer"
          ]
        },
        "stem": {
          "$ref": "#/$defs/stemDocument"
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/partChoice"
          }
        },
        "suggestedAnswer": {
          "$ref": "#/$defs/document"
        },
        "points": {
          "$ref": "#/$defs/points"
        },
        "subparts": {
          "description": "The Subparts this Part holds, in the order they are numbered (i), (ii)…. A Part that holds Subparts answers nothing itself: its stem is their lead-in, and it has no `type`, `choices` or `suggestedAnswer`. Added in 0.9.0.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/subpart"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "multiple-choice"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "choices": {
                "$ref": "#/$defs/part/properties/choices"
              }
            },
            "required": [
              "choices"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "subparts": {
                "type": "array"
              }
            },
            "required": [
              "subparts"
            ]
          },
          "then": {
            "properties": {
              "type": false,
              "choices": false,
              "suggestedAnswer": false,
              "points": false
            }
          },
          "else": {
            "properties": {
              "type": {
                "$ref": "#/$defs/part/properties/type"
              }
            },
            "required": [
              "type"
            ]
          }
        }
      ]
    },
    "subpart": {
      "description": "A Subpart of a Part, numbered (i), (ii)… in authored order: a Multiple Choice or Short Answer question shaped like a Part that answers. It never holds Subparts of its own. Added in 0.9.0.",
      "type": "object",
      "required": [
        "id",
        "type",
        "stem"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^q[1-9][0-9]*-s[1-9][0-9]*-s[1-9][0-9]*$"
        },
        "type": {
          "enum": [
            "multiple-choice",
            "short-answer"
          ]
        },
        "stem": {
          "$ref": "#/$defs/stemDocument"
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/subpartChoice"
          }
        },
        "suggestedAnswer": {
          "$ref": "#/$defs/document"
        },
        "points": {
          "$ref": "#/$defs/points"
        },
        "subparts": false
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "multiple-choice"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "choices": {
                "$ref": "#/$defs/subpart/properties/choices"
              }
            },
            "required": [
              "choices"
            ]
          }
        }
      ]
    },
    "subpartChoice": {
      "type": "object",
      "required": [
        "id",
        "content",
        "correct"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^q[1-9][0-9]*-s[1-9][0-9]*-s[1-9][0-9]*-c[1-9][0-9]*$"
        },
        "content": {
          "$ref": "#/$defs/document"
        },
        "correct": {
          "type": "boolean"
        },
        "locked": {
          "description": "Whether this answer is a Locked Answer, which keeps its authored position however answers are shuffled. `true` locks it; `false` records that its author unlocked it, so a consumer that locks answers by their wording must not; absent, the record makes no decision.",
          "type": "boolean"
        }
      }
    },
    "points": {
      "description": "What answering it is worth, as a positive whole number. Absent means unpointed, which is not the same as worth nothing: it adds nothing to a total. A Multipart Question's Points, and a paper's total, are always the sum of what its answering Parts and Subparts carry, and are never written. Added in 0.9.0.",
      "type": "integer",
      "minimum": 1
    },
    "question": {
      "type": "object",
      "required": [
        "id",
        "type",
        "stem"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^q[1-9][0-9]*$"
        },
        "type": {
          "enum": [
            "multiple-choice",
            "true-false",
            "matching",
            "short-answer",
            "multipart"
          ]
        },
        "stem": {
          "$ref": "#/$defs/stemDocument"
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "points": {
          "$ref": "#/$defs/points"
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/choice"
          }
        },
        "prompts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/prompt"
          }
        },
        "wordBank": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/wordBankAnswer"
          }
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/part"
          }
        },
        "suggestedAnswer": {
          "$ref": "#/$defs/document"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "multiple-choice"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "choices": {
                "$ref": "#/$defs/question/properties/choices"
              }
            },
            "required": [
              "choices"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "true-false"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "choices": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "$ref": "#/$defs/choice",
                  "$comment": "A True/False pair never moves, so neither of its answers carries `locked`.",
                  "type": "object",
                  "properties": {
                    "locked": false
                  }
                }
              }
            },
            "required": [
              "choices"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "matching"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "prompts": {
                "$ref": "#/$defs/question/properties/prompts"
              },
              "wordBank": {
                "$ref": "#/$defs/question/properties/wordBank"
              }
            },
            "required": [
              "prompts",
              "wordBank"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "multipart"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "parts": {
                "$ref": "#/$defs/question/properties/parts"
              },
              "points": false
            },
            "required": [
              "parts"
            ]
          }
        }
      ]
    },
    "pending": {
      "description": "A Pending Image: the picture is named by the Image Tag printed on it in a labeled copy of the Source Document, or only by its 1-based page, and its bytes are supplied later.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "image": {
          "type": "integer",
          "minimum": 1
        },
        "page": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "crop": {
      "description": "A Picture Crop: the part of the block image’s Media Asset that shows, as fractions 0–1 of the upright picture (after any EXIF orientation), measured from its top-left. `left` must be less than `right` and `top` less than `bottom`; a crop keeping the whole picture is omitted. Only a block image with an `asset` may carry one.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left",
        "top",
        "right",
        "bottom"
      ],
      "properties": {
        "left": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "top": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "right": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "bottom": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
